<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>GuozuYa</AssemblyName>
        <RootNamespace>GuozuYa</RootNamespace>

        <!-- 《逃离鸭科夫》安装目录（包含 Duckov.exe 的目录），可按需修改 -->
        <DuckovPath Condition="'$(DuckovPath)' == ''">E:\SteamLibrary\steamapps\common\Escape from Duckov</DuckovPath>
        <ManagedPath>$(DuckovPath)\Duckov_Data\Managed\</ManagedPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="$(ManagedPath)TeamSoda.*">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(ManagedPath)ItemStatsSystem.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(ManagedPath)SodaLocalization.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(ManagedPath)Unity*">
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
