{
  "manifest_version": 3,
  "name": "BehaviorCollector 浏览器采集",
  "version": "0.1.0",
  "description": "把 Chrome 标签页、URL 与窗口切换事件写入本机 BehaviorCollector。仅本机，不联网、不上传。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
